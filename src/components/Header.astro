---
import { nav } from '../data/site';
import type { NavLink } from '../data/site';

const norm = (h = '') => h.replace(/\/$/, '') || '/';
const path = norm(Astro.url.pathname);
const isActive = (href?: string) => norm(href) === path;
const groupActive = (links: NavLink[]) => links.some((l) => isActive(l.href));
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Decoheron home">
      <img class="logo-light" src="/img/logo-light.png" alt="" width="78" height="36" />
      <img class="logo-dark" src="/img/logo-dark.png" alt="" width="78" height="36" />
      DECOHERON
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">MENU</button>
    <ul class="nav" id="site-nav">
      {nav.map((item) =>
        item.children ? (
          <li class="has-sub">
            <button aria-expanded="false" aria-current={groupActive(item.children) ? 'true' : undefined}>{item.label} &#9662;</button>
            <ul class="submenu">
              {item.children.map((c) => (
                <li><a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        )
      )}
      <li>
        <button class="mode-toggle" title="Colour mode: auto" aria-label="Colour mode">
          <span aria-hidden="true">&#9680;</span><span class="toggle-label"> Mode: auto</span>
        </button>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header') as HTMLElement;

  // Mobile menu
  const menuToggle = header.querySelector('.menu-toggle') as HTMLButtonElement;
  menuToggle.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  // Dropdowns (hover is handled in CSS on desktop; click works everywhere)
  header.querySelectorAll('.has-sub').forEach((group) => {
    const button = group.querySelector('button') as HTMLButtonElement;
    button.addEventListener('click', () => {
      const open = group.classList.toggle('open');
      button.setAttribute('aria-expanded', String(open));
    });
  });

  // Colour mode: auto follows the system setting, light and dark override it. Saved per browser.
  const modes = ['auto', 'light', 'dark'];
  const modeToggle = header.querySelector('.mode-toggle') as HTMLButtonElement;
  const modeLabel = modeToggle.querySelector('.toggle-label') as HTMLElement;
  const root = document.documentElement;
  let mode = 'auto';
  try { mode = localStorage.getItem('theme') ?? 'auto'; } catch (e) {}
  if (!modes.includes(mode)) mode = 'auto';

  function applyMode() {
    if (mode === 'auto') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', mode);
    modeToggle.title = `Colour mode: ${mode}`;
    modeLabel.textContent = ` Mode: ${mode}`;
    try {
      if (mode === 'auto') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch (e) {}
  }
  applyMode();
  modeToggle.addEventListener('click', () => {
    mode = modes[(modes.indexOf(mode) + 1) % modes.length];
    applyMode();
  });
</script>
