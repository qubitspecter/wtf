---
import Page from "../../layouts/Page.astro";
import { services } from "../../data/site";

export function getStaticPaths() {
    return services.map((i) => ({
        params: { sect: i.sect },
        props: { name: i.name },
    }));
}
const { name } = Astro.props;
---

<Page eyebrow="Sectors" title={name} />
